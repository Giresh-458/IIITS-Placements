# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/placement_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=placement_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
SCHEDULER_INTERVAL_SECONDS=5

# LLM / Ollama
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3

# Crawl Budget
MAX_RUNTIME_SECONDS=3600
MAX_URLS=1000
MAX_PAGES_PER_SOURCE=50
MAX_DEPTH=3
MAX_BROWSER_PAGES=5
MAX_PDF_PAGES=20
MAX_RETRIES=3
PER_DOMAIN_DELAY_SECONDS=2
REQUEST_TIMEOUT_SECONDS=30
BROWSER_TIMEOUT_SECONDS=60

# Eligibility / Business rules
CSE_MIN_LPA=10.0
ECE_MIN_LPA=6.5
RECENT_EVENT_DAYS_WINDOW=15

# Feature Flags
ENABLE_SCHEDULED_CRAWLS=false
